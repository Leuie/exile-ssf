{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exile-ssf",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "EXILE_DB",
      "database_name": "exile-ssf-db",
      "database_id": "2b0b12b6-c4d7-4378-bae6-352d56f026a8"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EXILE_KV",
      "id": "077c653a1f8f4acd9ec50b9adce22132"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
