{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exile-ssf",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "EXILE_KV",
      "id": "exile_ssf_kv"
    }
  ]
}
